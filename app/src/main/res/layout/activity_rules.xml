<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/Wuad.PageTitle"
        android:text="规则" />

    <RadioGroup
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/tabDns" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="anti-AD" android:textColor="@color/text" />
        <RadioButton android:id="@+id/tabGkd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GKD" android:textColor="@color/text" />
        <RadioButton android:id="@+id/tabRoute" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分流" android:textColor="@color/text" />
    </RadioGroup>

    <TextView
        android:id="@+id/presetLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:hint="预置订阅地址"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnSaveUrl"
            style="@style/Wuad.RowBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="保存地址" />
        <Button
            android:id="@+id/btnUpdate"
            style="@style/Wuad.RowBtn"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="更新规则" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnPreset"
            style="@style/Wuad.RowBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="停用预置" />
        <Button
            android:id="@+id/btnRestore"
            style="@style/Wuad.RowBtn"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="恢复预置" />
    </LinearLayout>

    <TextView
        android:id="@+id/drill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:text="← 返回应用列表"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:hint="搜索规则"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted" />

    <Button
        android:id="@+id/btnAdd"
        style="@style/Wuad.RowBtn"
        android:text="添加规则" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
