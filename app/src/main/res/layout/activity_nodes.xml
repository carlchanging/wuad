<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/Wuad.PageTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="节点" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="分流"
            android:textColor="@color/muted"
            android:textSize="13sp" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swRoute"
            style="@style/Wuad.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="先开网络栈。没填机场就只剩 DIRECT。"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="8dp">
        <RadioButton android:id="@+id/modeRule" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="规则" android:textColor="@color/text" />
        <RadioButton android:id="@+id/modeGlobal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全局" android:textColor="@color/text" />
        <RadioButton android:id="@+id/modeDirect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="直连" android:textColor="@color/text" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnDelay"
            style="@style/Wuad.RowBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="测速" />
        <Button
            android:id="@+id/btnRefresh"
            style="@style/Wuad.RowBtn"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="更新订阅" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
