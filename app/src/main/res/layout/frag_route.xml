<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="36dp">

        <TextView
            style="@style/Wuad.PageTitle"
            android:text="分流" />

        <LinearLayout
            style="@style/Wuad.SwitchRow"
            android:layout_marginTop="16dp">
            <LinearLayout style="@style/Wuad.SwitchBody">
                <TextView style="@style/Wuad.SwitchTitle" android:text="分流" />
                <TextView style="@style/Wuad.SwitchSub" android:text="只做路由。广告由 DNS 拦，不走 REJECT。" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Wuad.Section"
            android:text="订阅" />

        <TextView
            android:id="@+id/subHint"
            style="@style/Wuad.Caption"
            android:layout_marginTop="0dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/subList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <EditText
                android:id="@+id/subNewName"
                style="@style/Wuad.Field"
                android:layout_marginTop="0dp"
                android:hint="名称" />
            <EditText
                android:id="@+id/subNewUrl"
                style="@style/Wuad.Field"
                android:hint="https://… Clash / mihomo 订阅"
                android:inputType="textUri" />
            <Button
                android:id="@+id/btnSubAdd"
                style="@style/Wuad.RowBtn"
                android:text="添加订阅" />
        </LinearLayout>

        <TextView
            style="@style/Wuad.Section"
            android:text="资源与应用" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">
            <Button
                android:id="@+id/btnGeo"
                style="@style/Wuad.NavRow"
                android:text="Geo 资源" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/line" />
            <Button
                android:id="@+id/btnApps"
                style="@style/Wuad.NavRow"
                android:text="隧道分应用" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/line" />
            <Button
                android:id="@+id/btnIgnoreApps"
                style="@style/Wuad.NavRow"
                android:text="不启用的应用" />
        </LinearLayout>
        <TextView
            android:id="@+id/ignoreHint"
            style="@style/Wuad.Caption" />

        <TextView
            style="@style/Wuad.Section"
            android:text="规则" />

        <include
            android:id="@+id/rules"
            layout="@layout/include_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
