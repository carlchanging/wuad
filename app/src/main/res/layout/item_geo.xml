<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:inputType="textUri"
        android:padding="10dp"
        android:textColor="@color/text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnSave" style="@style/Wuad.RowBtn" android:layout_width="0dp" android:layout_weight="1" android:text="保存地址" />
        <Button android:id="@+id/btnUpdate" style="@style/Wuad.RowBtn" android:layout_width="0dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="更新" />
        <Button android:id="@+id/btnDelete" style="@style/Wuad.RowBtn" android:layout_width="0dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="删本地" />
    </LinearLayout>
</LinearLayout>
